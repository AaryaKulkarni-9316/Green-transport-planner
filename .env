# ─── Green Transport Planner — Environment Variables ───────────────────────
# Copy/rename this file to .env and fill in your actual API keys.

# MongoDB (optional — app runs in in-memory mode without it)
MONGO_URI=mongodb://localhost:27017/green_transport

# JWT signing secret — change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string-in-production

# TomTom Maps API — https://developer.tomtom.com/ (free tier available)
# Leave blank to use demo/offline mode
TOMTOM_API_KEY=253Ignqg4Se7Dq6ktSla0wGcnoFskDBa

# OpenAI API — https://platform.openai.com/ (optional for AI chatbot)
# Leave blank to use built-in keyword fallback responses
OPENAI_API_KEY=

# Port (default 5000)
PORT=5000
